import pool from "../src/database/connection.js";

import { saveBankAccount } from "./BankAccountService.js";
import { saveBankTransaction } from "./BankTransactionService.js";

import {
    getAccountsByItemId,
    getTransactionsByAccountId
} from "./PluggyService.js";


export async function syncBankData(userId) {

    const connections = await pool.query(
        `
        SELECT id, pluggy_item_id
        FROM bank_connections
        WHERE user_id = $1
        `,
        [userId]
    );

    if (connections.rows.length === 0) {
        throw new Error(
            "Nenhuma conexão bancária encontrada"
        );
    }

    const savedAccounts = [];
    const savedTransactions = [];

    for (const connection of connections.rows) {

        const accounts = await getAccountsByItemId(
            connection.pluggy_item_id
        );

        for (const account of accounts) {

            // Salva ou atualiza a conta
            const savedAccount = await saveBankAccount(
                account,
                connection.id,
                userId
            );

            savedAccounts.push(savedAccount);

            // Busca as transações dessa conta
            const transactions =
                await getTransactionsByAccountId(
                    account.id
                );

            for (const transaction of transactions) {

                const savedTransaction =
                    await saveBankTransaction(
                        transaction,
                        userId
                    );

                savedTransactions.push(
                    savedTransaction
                );
            }
        }
    }

    return {
        accounts: savedAccounts,
        transactions: savedTransactions
    };
}